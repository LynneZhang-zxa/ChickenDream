# ALEBEX voice (required). Download the .env from the console (Voice API key → ".env file") and copy the key here.
ALEBEX_API_KEY=wt_your_key_here
# Written automatically by `npm run create-agent`
ALEBEX_AGENT_ID=

# Optional: https base the ALEBEX engine can reach for tool calls. Auto-detected from a running `ngrok http 3000` when unset.
PUBLIC_BASE=

# Optional: Supabase mirror of cooking sessions (app works without it)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
